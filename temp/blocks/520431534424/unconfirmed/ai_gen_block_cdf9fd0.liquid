<script>
  (function() {
    class AiIngredients{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.observeCards();
      }

      observeCards() {
        const cards = this.querySelectorAll('.ai-ingredients-card-{{ ai_gen_id }}');
        
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry, index) => {
              if (entry.isIntersecting) {
                setTimeout(() => {
                  entry.target.style.opacity = '1';
                  entry.target.style.transform = 'translateY(0)';
                }, index * 100);
                observer.unobserve(entry.target);
              }
            });
          }, {
            threshold: 0.1
          });

          cards.forEach((card) => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
            observer.observe(card);
          });
        }
      }
    }

    customElements.define('ai-ingredients-{{ ai_gen_id }}', AiIngredients{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Premium ingredients",
  "settings": [
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Gentle enough for daily use"
    },
    {
      "type": "checkbox",
      "id": "show_badge_icon",
      "label": "Show heart icon",
      "default": true
    },
    {
      "type": "color",
      "id": "badge_background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Text color",
      "default": "#6B5744"
    },
    {
      "type": "color",
      "id": "badge_border_color",
      "label": "Border color",
      "default": "#D4C4B0"
    },
    {
      "type": "color",
      "id": "badge_icon_color",
      "label": "Icon color",
      "default": "#B8A060"
    },
    {
      "type": "range",
      "id": "badge_font_size",
      "label": "Font size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "badge_spacing",
      "label": "Spacing below badge",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "7 Cold-Pressed Oils. One Purpose: Better Skin."
    },
    {
