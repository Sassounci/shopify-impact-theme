{% doc %}
  @prompt
    Create a premium “Ingredients” section for a luxury skincare brand.
    
    Style:
    Minimal, elegant, clean luxury aesthetic inspired by modern cosmetic brands. Warm beige background (#F5EFE4 style), soft shadows, rounded corners, balanced spacing, sophisticated typography.
    
    Layout:
    - Centered badge pill at the top with a thin border and small heart icon
    - Large luxury serif headline centered
    - Small descriptive subtitle below
    - Ingredient cards displayed in a responsive grid
    - 4 cards on first row, 3 cards centered on second row
    - Desktop + mobile responsive
    
    Section content:
    Top badge text:
    “Gentle enough for daily use”
    
    Headline:
    “7 Cold-Pressed Oils. One Purpose: Better Skin.”
    
    Subtitle:
    “Preserved in their purest form to deeply nourish and support your skin.”
    
    Ingredient cards:
    Each card contains:
    - ingredient image/icon at the top left
    - ingredient name in dark brown
    - checkmark icon
    - short skincare benefit underneath
    
    Ingredients:
    1. Sweet Almond
    “smoothes & deeply hydrates”
    
    2. Evening Primrose
    “firms & increases elasticity”
    
    3. Rosehip
    “regenerates & plumps skin”
    
    4. Vitamin E
    “protects the skin from sun light”
    
    5. Geranium
    “tightens & revitalises”
    
    6. Lavender
    “calms inflammation whilst promoting healing”
    
    7. Patchouli
    “boost natural collagen production & smooths skin”
    
    Design details:
    - Cards with white/light cream background
    - Rounded corners (20px)
    - Soft luxury shadows
    - Elegant serif heading font
    - Clean sans-serif body font
    - Dark brown text color
    - Plenty of whitespace
    - Premium skincare / spa atmosphere
    - Smooth hover animation on cards
    - Subtle fade-in animation when section appears
    
    Important:
    Make the section editable in Shopify:
    - editable badge
    - editable title
    - editable subtitle
    - dynamic ingredient blocks
    - editable ingredient image
    - editable ingredient name
    - editable ingredient benefit text
    - customizable colors and spacing in theme editor
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ingredients-section-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    display: block;
  }

  .ai-ingredients-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-ingredients-badge-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 20px;
    border: 1px solid {{ block.settings.badge_border_color }};
    border-radius: 50px;
    background-color: {{ block.settings.badge_background_color }};
    color: {{ block.settings.badge_text_color }};
    font-size: {{ block.settings.badge_font_size }}px;
    margin: 0 auto {{ block.settings.badge_spacing }}px;
    width: fit-content;
  }

  .ai-ingredients-badge-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    fill: {{ block.settings.badge_icon_color }};
  }

  .ai-ingredients-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-ingredients-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
  }

  .ai-ingredients-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    line-height: 1.6;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-ingredients-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.card_gap }}px;
    margin-top: {{ block.settings.grid_spacing }}px;
  }

  .ai-ingredients-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: {{ block.settings.card_shadow_horizontal }}px {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-ingredients-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: {{ block.settings.card_shadow_horizontal }}px {{ block.settings.card_shadow_vertical | plus: 4 }}px {{ block.settings.card_shadow_blur | plus: 10 }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 | times: 1.3 }});
  }

  .ai-ingredients-card-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .ai-ingredients-card-image-{{ ai_gen_id }} {
    width: {{ block.settings.ingredient_image_size }}px;
    height: {{ block.settings.ingredient_image_size }}px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
  }

  .ai-ingredients-card-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-ingredients-card-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.background_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-ingredients-card-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-ingredients-card-title-wrapper-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-ingredients-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.ingredient_name_size }}px;
    font-weight: 600;
    color: {{ block.settings.ingredient_name_color }};
    margin: 0;
    line-height: 1.3;
  }

  .ai-ingredients-card-checkmark-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .ai-ingredients-card-checkmark-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.checkmark_color }};
  }

  .ai-ingredients-card-benefit-{{ ai_gen_id }} {
    font-size: {{ block.settings.benefit_text_size }}px;
    line-height: 1.5;
    color: {{ block.settings.benefit_text_color }};
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-ingredients-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-ingredients-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-ingredients-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-ingredients-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px {{ block.settings.section_padding_horizontal | times: 0.6 }}px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-ingredients-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.card_gap | times: 0.8 }}px;
    }

    .ai-ingredients-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

