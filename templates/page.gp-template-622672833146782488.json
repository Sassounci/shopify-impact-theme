        "checksum": "9923e6b9f9a562e712affc8de5ba13dda7c9ca0095f4dcd26f16de9e7e4722d2_1_1_1_0__1",
        "ggKwNfyl0Zk_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0988/0413/8328/files/ChatGPT_Image_5_juin_2026_17_33_20.png",
        "gg94jZ05GUj_text": "Le vrai problème, c’est le vent",
        "ggBZoP8CAFr_text": "<p>À partir de 80 km/h, le bruit du vent devient lourd.</p><p> </p><p>Il fatigue la tête.<br>Il fait siffler les oreilles.<br>Il casse le plaisir de rouler.</p><p>Auryde™ réduit ce bruit sans vous isoler de la route.</p>",
        "ggpaSTYY6l-_text": "Vous entendez encore ce qui compte",
        "ggN8Z0Oad9D_text": "<p>Le but n’est pas de tout bloquer.</p><p>Le but, c’est de réduire le bruit du vent.</p><p> </p><p>Vous gardez les sons importants :<br>circulation, moteur, GPS, intercom.</p><p> </p><p>Vous roulez plus calme.<br>Mais toujours connecté à la route.</p>",
        "gg6ttt0cHHT_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0988/0413/8328/files/ChatGPT_Image_5_juin_2026_17_35_13.png",
        "ggM9-62E29R_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0988/0413/8328/files/gempages_519052065381549017-3d31114f-3447-4858-812b-08b8b0ab3dd8.gif?v=1780378469",
        "ggL1i2LNUM1_text": "Confortable sous le casque",
        "ggKaQ9Vh2Xk_text": "<p>Les bouchons classiques peuvent faire mal.</p><p> </p><p>Auryde™ est discret, souple et pensé pour rester en place sous le casque.</p><p> </p><p>Vous le mettez.<br>Vous roulez.<br>Vous l’oubliez.</p>"
      }
    },
    "gp_section_622673033600959117": {
      "type": "gp-section-622673033600959117",
      "settings": {
        "section_preload": "false",
        "checksum": "a434df3fa8b457f8e73b92b6935066789a93a7be6ef4c03f1aec6f0ca8829d1e_1_1_1_0__1",
        "ggZBbGOmzZP_text": "Écoutez la différence",
        "ggYZO72fCYB_youtubeUrl": "https://www.youtube.com/watch?v=NfASaHFN1zg",
        "ggYZO72fCYB_vimeoUrl": "https://vimeo.com/1095883398",
        "ggYZO72fCYB_html5Url": "https://cdn.shopify.com/videos/c/o/v/cdd5b288917e41419477aa2b930777d3.mp4",
        "ggzF-5KteLc_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0988/0413/8328/files/1f7d2b536ae8c280db8761f3929ba5cf.jpg?v=1780400896",
        "gg61ine0NmU_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(26,26,26);\">\"Je pensais que c'était normal d'être fatigué après une grosse sortie. Depuis Auryde, je termine mes balades beaucoup plus en forme.\"</span></p>",
        "ggbXohnARfZ_text": "<span style=\"background-color:rgb(255,255,255);color:rgb(26,26,26);\"><strong>Julien, MT-07</strong></span>",
        "ggDUeHuOYjp_text": "<p>5.0</p>",
        "ggEl-AJDTZH_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0988/0413/8328/files/Screenshot_2026-02-02_at_19.26.00.png?v=1780216820",
        "gg7q020zyRu_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(26,26,26);\">\"J'avais peur de me sentir isolé de la route. C'est exactement le contraire. J'entends mieux l'intercom qu'avant. Le vent est parti, le reste est là. Fini les oreilles qui sifflent le soir après 500 km dans les Alpes.\"</span></p>",
        "ggVlL56T9At_text": "<span style=\"background-color:rgb(255,255,255);color:rgb(26,26,26);\"><strong>Nicolas B, BMW R1250GS</strong></span>",
        "gg9jwx32raP_text": "<p>5.0</p>",
        "ggDvckPGkv6_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0988/0413/8328/files/Screenshot_2026-02-02_at_19.27.39.png?v=1780216645",
        "gg8V_Ptaktu_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(26,26,26);\">\"Au bout d'une heure j'avais oublié qu'ils étaient là. À l'arrivée, j'étais encore dispos — première fois sur un trajet de 3h. Ma femme m'a dit que je semblais moins tendu. Elle a commandé une paire pour son casque.\"</span></p>",
        "ggBylQ9lpTd_text": "<span style=\"background-color:rgb(255,255,255);color:rgb(26,26,26);\"><strong>Thomas M, Kawasaki Z900</strong></span>",
        "ggMXegQ8rd1_text": "<p>5.0</p>",
        "gg1tC7xhjhU_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0988/0413/8328/files/Screenshot_2026-02-02_at_19.27.04.png?v=1780216658",
        "ggzWNPbE_J7_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(26,26,26);\">\"J'avais essayé des bouchons classiques mais tombaient ou faisaient mal. 4 tailles incluses — j'ai trouvé la bonne taille, ils tiennent toute la journée. Le lendemain : aucun sifflement. Aucun. Première fois depuis des années.\"</span></p>",
        "gg2oaVQt7wh_text": "<span style=\"background-color:rgb(255,255,255);color:rgb(26,26,26);\"><strong>Sophie L, Honda CB650R</strong></span>",
        "ggOJGUngSJi_text": "<p>5.0</p>",
        "ggbTjtNQSuE_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0988/0413/8328/files/Screenshot_2026-02-02_at_19.27.20.png?v=1780216683",
        "gg15NK0pEr8_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(26,26,26);\">\"Je fais Grenoble-Lyon tous les jours depuis 3 ans. J'arrivais au bureau la tête lourde et les oreilles qui sonnaient. Ça fait 2 mois que j'utilise AuRyde — c'est le jour et la nuit. Concentré, pas vidé. L'intercom avec mon passager est clairement mieux — on n'a plus besoin de répéter.\"</span></p>",
        "ggdA5XhHwB6_text": "<span style=\"background-color:rgb(255,255,255);color:rgb(26,26,26);\"><strong>Mathieu L, Hornet 750</strong></span>",
        "ggCCyoTBBWj_text": "<p>5.0</p>",
        "ggrIrwmBvp0_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0988/0413/8328/files/a42a4967d631aab92553b67d0e9b5bda.jpg?v=1780401283",
        "gg-WRLNxOWX_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(26,26,26);\">\"J'entends mieux mon intercom qu'avant. Le vent ne couvre plus tout.\"</span></p>",
        "gghGMzHjAy__text": "<span style=\"background-color:rgb(255,255,255);color:rgb(26,26,26);\"><strong>Nicolas, Tracer 700</strong></span>",
        "ggpZr6elpYV_text": "<p>5.0</p>"
      }
    },
