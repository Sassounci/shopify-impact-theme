    "gp_section_620043869890806730": {
      "settings": {
        "checksum": "3d4104ff9f4a4c78f1d8f4e1db8743218b79c5304e8d19b39b901bd50aa2eef1_1_1_1_0__1",
        "gg7Y37BWyzw_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0988/0413/8328/files/Isabelle.png?v=1777981010",
        "gg7Y37BWyzw_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0988/0413/8328/files/Isabelle.png?v=1777981010",
        "gg8Ci8_o4cE_text": "Pourquoi des milliers de femmes ne peuvent plus s’en passer",
        "gg92bIcc6Yl_text": "<p><span style=\"color:#000000;\"><strong>Catherine</strong></span> | Client vérifé &nbsp;</p>",
        "ggFKAaeLjXY_text": "<p>Avec cette huile raffermissante rien avoir !</p>",
        "ggFPd1hwKD-_text": "<p><span style=\"color:#000000;\"><strong>Florence</strong> </span>| Client vérifé &nbsp;</p>",
        "ggK3ulHvPtl_text": "<p>\"J'ai perdu 22 kilos. Le poids est parti, ma peau n'a pas suivi. Je me cachais encore plus qu'avant. Trois mois avec cette huile et la peau de mon ventre s'est resserrée. Je peux enfin me regarder dans le miroir. \"</p>",
        "ggOVSZ8HoCY_text": "<p>\"J'avais peur que ce soit encore un produit marketing. J'ai testé le bio oil pendant 3 ans, des crèmes à 80€, rien.&nbsp;</p><p>Avec cette huile raffermissante rien avoir ! au bout de 6 semaines, mes bras ne ressemblent plus à du papier crépon. J'ai porté une robe sans manches à un mariage. Première fois depuis 4 ans.\"</p>",
        "ggZRQZtSPSq_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0988/0413/8328/files/feedback-img-4.png?v=1778308722",
        "ggZRQZtSPSq_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0988/0413/8328/files/feedback-img-4.png?v=1778308722",
        "gggz27v09A8_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0988/0413/8328/files/Catherine.png?v=1777975653",
        "gggz27v09A8_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0988/0413/8328/files/Catherine.png?v=1777975653",
        "ggkkOApuyKf_text": "<p>Avec cette huile raffermissante rien avoir !</p>",
        "ggkpVGMqxLR_text": "<p>+15 000 femmes convaincues</p>",
        "ggniu8yc_kq_text": "<p>Avec cette huile raffermissante rien avoir !</p>",
        "ggr7UhNgkLg_text": "<p>\"<span style=\"background-color:rgba(255, 255, 255, 0);color:rgb(31,31,31);\">À</span><span style=\"background-color:rgba(255, 255, 255, 0);\"> </span>la ménopause, ma peau est devenue fine comme du papier. Ma dermato m'a expliqué pourquoi mes crèmes ne marchaient pas. Cette huile descend plus profond. Ma peau a retrouvé du rebond. Ma peau a retrouvé du rebond. Je me sens à nouveau dans mon corps. \"</p>",
        "ggrs5o8oqKa_text": "<p><span style=\"color:#000000;\"><strong>Isabelle</strong></span> | Client vérifé &nbsp;</p>"
      },
