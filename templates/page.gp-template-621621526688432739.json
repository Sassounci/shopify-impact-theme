    "gp_section_621631338440557215": {
      "settings": {
        "checksum": "bcf9129c71b7a43fb43abc7a80a31dfefdacb233206e7ef9a8afad7860ab718a_1_1_1_0__1",
        "ggSdic1GebK_text": "<p><strong>AVANT</strong></p><p>&nbsp;</p><p>❌ Oreilles qui sifflent<br>❌ Tête lourde après autoroute<br>❌ Fatigue après 2h de route<br>❌ Intercom trop fort</p><p>&nbsp;</p><p><strong>APRÈS</strong></p><p>&nbsp;</p><p>✅ Trajet plus calme<br>✅ Plus concentré sur la route<br>✅ Moins fatigué à l’arrivée<br>✅ Roulez plus longtemps confortablement</p><p>&nbsp;</p><p><strong>Voyez vous même en cliquant sur la vidéo !</strong></p>",
        "ggbBTCq13TZ_html5Url": "https://cdn.shopify.com/videos/c/o/v/cdd5b288917e41419477aa2b930777d3.mp4",
        "ggbBTCq13TZ_vimeoUrl": "https://vimeo.com/1095883398",
        "ggbBTCq13TZ_youtubeUrl": "https://www.youtube.com/watch?v=NfASaHFN1zg"
