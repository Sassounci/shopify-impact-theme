    "gp_section_621629414798525027": {
      "settings": {
        "checksum": "daf90eb05d4ac64e693a5eb7464dd521a8ad6a2cff4b8c2ed101f23b0515b1aa_1_1_1_0__1",
        "gg-QYSJyVdc_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/2005/9307/files/gempages_432750572815254551-abc48d02-8307-4adc-8c7f-6864145944dc.png?v=1716866776",
        "gg-QYSJyVdc_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0988/0413/8328/files/Design_sans_titre_2.png",
        "gg5ZD_ztaIP_text": "<p>Avec ses 4 tailles incluses, elles s'adaptent à toutes les oreilles&nbsp;</p>",
        "gg8lgwoj6w8_text": "<p>Confort sous le casque</p>",
        "ggAxioStK0g_text": "<p>Réutilisable à vie</p>",
        "ggB5eOtmTUa_text": "<p>Le vent devient beaucoup moins fatiguant</p>",
        "ggBRK5c6Xe7_text": "<p>Intercom, circulation et moteur restent audibles</p>",
        "ggH9coXVTo4_text": "<p>Gardez les sons importants</p>",
        "ggNDeTwkyhq_text": "<p>Étui offert</p>",
        "ggRC1L6UjSh_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0988/0413/8328/files/Design_sans_titre_2.png",
        "ggXFJ15z7KX_text": "<p>Toujours avec vous sur la route sans perdre l'hygiène</p>",
        "ggaO47x7sAE_text": "<p>Ne fait pas mal même après plusieurs heures</p>",
        "ggbsQTGfWAB_text": "<p>S'adapte à tout le monde</p>",
        "ggg2hYCAhNy_text": "<p>Lavables et faits pour durer</p>",
        "ggt_X8ZBZPI_text": "<p>Moins de bruit agressif</p>"
      },
