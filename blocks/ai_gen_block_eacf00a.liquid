{% doc %}
  @prompt
    Create a premium testimonial section inspired by modern skincare brands, with a soft luxury aesthetic exactly like the reference image.
    
    SECTION LAYOUT:
    
    Large centered heading at the top
    Small trust line above the heading with 5 gold stars and text: “Trusted by women of all ages”
    Heading text large, elegant and serif font:
    “Visible Changes Verified By Women Who Use It”
    Small centered subtitle under heading:
    “See what customers are noticing after using Glow Body Oil daily.”
    
    GRID:
    
    4 testimonial cards displayed in a responsive horizontal grid on desktop
    On mobile: horizontal swipe carousel
    Equal spacing between cards
    Cards aligned perfectly
    
    EACH TESTIMONIAL CARD:
    
    Large rounded image at the top (portrait lifestyle image)
    Light gray review card underneath attached visually to the image
    Rounded corners everywhere
    Soft luxury skincare aesthetic
    
    INSIDE REVIEW CARD:
    
    Review title in bold black text
    Review text underneath
    Customer name at bottom
    Small verified customer line with gold verification icon
    Optional 5 gold stars above review title
    
    STYLE:
    
    Background color: warm beige / cream (#F5EFE6 style)
    Serif heading font similar to luxury cosmetic brands
    Clean sans-serif for body text
    Minimal premium skincare branding
    Soft shadows
    Rounded corners around cards
    Spacious padding
    Elegant feminine luxury look
    
    CUSTOMIZATION SETTINGS:
    
    Ability to add/edit:
    customer image
    review title
    review text
    customer name
    star rating
    verified badge toggle
    Ability to change:
    heading
    subtitle
    colors
    number of columns
    section spacing
    
    ANIMATIONS:
    
    Slight hover lift on desktop cards
    Smooth fade-in animation when section enters viewport
    
    IMPORTANT:
    
    Make the section visually almost identical to the provided reference
    Keep proportions and spacing very clean and balanced
    Make it feel like a premium Shopify skincare brand
    Optimized for both desktop and mobile
    Use Shopify section schema with editable blocks for testimonials
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonials-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-testimonials-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-testimonials-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-testimonials-trust-line-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .ai-testimonials-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
  }

  .ai-testimonials-star-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    fill: {{ block.settings.star_color }};
  }

  .ai-testimonials-trust-text-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    font-weight: 400;
    letter-spacing: 0.3px;
  }

  .ai-testimonials-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    font-size: {{ block.settings.heading_size_mobile }}px;
    line-height: 1.2;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
    letter-spacing: -0.5px;
  }

  .ai-testimonials-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.5;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-testimonials-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    gap: {{ block.settings.card_gap_mobile }}px;
    margin-top: {{ block.settings.grid_top_spacing }}px;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .ai-testimonials-grid-{{ ai_gen_id }}.ai-testimonials-visible-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-testimonials-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease;
  }

  .ai-testimonials-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    margin-bottom: -{{ block.settings.card_overlap }}px;
    position: relative;
    z-index: 1;
  }

  .ai-testimonials-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    object-fit: cover;
  }

  .ai-testimonials-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    background-color: #e8e8e8;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-testimonials-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-testimonials-review-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: 0 {{ block.settings.card_shadow_y }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
    position: relative;
    z-index: 2;
  }

  .ai-testimonials-card-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 3px;
    margin-bottom: 12px;
  }

  .ai-testimonials-card-star-{{ ai_gen_id }} {
    width: 14px;
    height: 14px;
    fill: {{ block.settings.star_color }};
  }

  .ai-testimonials-review-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.heading_color }};
    margin: 0 0 10px;
    line-height: 1.3;
  }

  .ai-testimonials-review-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0 0 16px;
  }

  .ai-testimonials-customer-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.customer_name_size }}px;
    font-weight: 500;
    color: {{ block.settings.heading_color }};
    margin: 0 0 6px;
  }

  .ai-testimonials-verified-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: {{ block.settings.verified_text_color }};
  }

  .ai-testimonials-verified-icon-{{ ai_gen_id }} {
    width: 14px;
    height: 14px;
    fill: {{ block.settings.verified_icon_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-testimonials-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top }}px 40px {{ block.settings.section_padding_bottom }}px;
    }

    .ai-testimonials-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }

    .ai-testimonials-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
      gap: {{ block.settings.card_gap_desktop }}px;
    }

    .ai-testimonials-card-{{ ai_gen_id }}:hover {
      transform: translateY(-8px);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-testimonials-grid-{{ ai_gen_id }} {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .ai-testimonials-grid-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-testimonials-card-{{ ai_gen_id }} {
      scroll-snap-align: start;
      min-width: 280px;
    }
  }
{% endstyle %}

